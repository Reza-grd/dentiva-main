-- =============================================================================
-- Fixture bersama untuk tes pgTAP Dentiva Console.
-- Dipanggil dari tiap file tes dengan: \ir helpers/fixtures.psql (ekstensi .psql agar tidak dijalankan sebagai tes)
-- Semua dijalankan di dalam transaksi tes (di-ROLLBACK di akhir).
--
--   Klinik A  (active)   admin A, dokter A (suspended nanti di tes)
--   Klinik B  (active)   admin B
--   Klinik S  (suspended)
-- =============================================================================

create extension if not exists pgtap with schema extensions;

-- Helper: login sebagai user tertentu (meniru JWT Supabase).
create or replace function pg_temp.login_as(p_user uuid)
returns void
language plpgsql
as $$
declare
  v_claims jsonb;
begin
  select jsonb_build_object(
           'sub', au.id,
           'role', 'authenticated',
           'aal', 'aal1',
           'app_metadata', coalesce(au.raw_app_meta_data, '{}'::jsonb))
  into v_claims
  from auth.users au where au.id = p_user;

  perform set_config('request.jwt.claims', v_claims::text, true);
  perform set_config('request.jwt.claim.sub', p_user::text, true);
  execute 'set local role authenticated';
end;
$$;

create or replace function pg_temp.logout()
returns void
language plpgsql
as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end;
$$;

