{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@dentiva/console"
      ],
      "port": 5174
    },
    {
      "name": "clinic",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@dentiva/clinic"
      ],
      "port": 3000
    },
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4000",
        "--directory",
        "D:/dentiva/dentiva_website"
      ],
      "port": 4000
    },
    {
      "name": "website-cleanurls",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve@14",
        "-l",
        "4010",
        "D:/dentiva/dentiva_website"
      ],
      "port": 4010
    },
    {
      "name": "eira-pameran",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/dentiva/eira-pameran",
        "run",
        "dev"
      ],
      "port": 5180
    }
  ]
}