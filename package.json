{
  "name": "dentiva",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "description": "Monorepo Dentiva: aplikasi klinik (apps/clinic), Dentiva Console (apps/console), paket bersama (packages/*), dan Supabase (supabase/).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npm run dev -w @dentiva/clinic",
    "dev:clinic": "npm run dev -w @dentiva/clinic",
    "dev:console": "npm run dev -w @dentiva/console",
    "build": "npm run build -w @dentiva/clinic && npm run build -w @dentiva/console",
    "build:clinic": "npm run build -w @dentiva/clinic",
    "build:console": "npm run build -w @dentiva/console",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:api",
    "test:api": "vitest run --config supabase/functions/console-api/vitest.config.ts",
    "test:e2e": "npm run test:e2e -w @dentiva/clinic",
    "db:types": "supabase gen types typescript --linked --schema public,platform > packages/supabase/src/database.types.ts",
    "db:test": "supabase test db",
    "db:new": "supabase migration new",
    "storybook": "npm run storybook -w @dentiva/clinic",
    "db:smoke": "node supabase/tests/smoke/migrations.smoke.mjs",
    "check:functions": "bash scripts/check-edge-functions.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@emnapi/runtime": "1.11.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
