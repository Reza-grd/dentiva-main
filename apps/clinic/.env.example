# Dentiva — aplikasi klinik. Salin ke .env.local
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# JANGAN set VITE_ENCRYPTION_KEY — semua VITE_* ikut ter-bundle ke browser dan build akan
# ditolak. Kunci lama hanya dipakai skrip migrasi lewat LEGACY_ENCRYPTION_KEY.

# Opsional
VITE_SENTRY_DSN=

# Pembayaran langganan Dentiva (diisi pemilik di Vercel → Environment Variables)
# Mode bawaan "manual": transfer ke rekening Dentiva + konfirmasi WhatsApp, diverifikasi di Console.
# Isi VITE_BILLING_MODE=midtrans hanya setelah akun Midtrans & MIDTRANS_SERVER_KEY di VPS siap.
VITE_BILLING_MODE=manual
VITE_BILLING_BANK=
VITE_BILLING_REKENING=
VITE_BILLING_ATAS_NAMA=
VITE_BILLING_WA=
