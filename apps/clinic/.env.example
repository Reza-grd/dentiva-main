# Dentiva — aplikasi klinik. Salin ke .env.local
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# JANGAN set VITE_ENCRYPTION_KEY — semua VITE_* ikut ter-bundle ke browser dan build akan
# ditolak. Kunci lama hanya dipakai skrip migrasi lewat LEGACY_ENCRYPTION_KEY.

