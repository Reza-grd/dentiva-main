# Dentiva — aplikasi klinik. Salin ke .env.local
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# JANGAN set VITE_ENCRYPTION_KEY — semua VITE_* ikut ter-bundle ke browser dan build akan
# ditolak. Kunci lama hanya dipakai skrip migrasi lewat LEGACY_ENCRYPTION_KEY.

# Opsional
VITE_SENTRY_DSN=

# Pembayaran langganan Dentiva (diisi pemilik di Vercel → Environment Variables)
# Pembayaran lewat Midtrans Snap. Client key (publik) + lingkungan: sandbox | production
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_ENV=sandbox
# Rekening & WA di bawah hanya dicetak pada invoice PDF
VITE_BILLING_BANK=
VITE_BILLING_REKENING=
VITE_BILLING_ATAS_NAMA=
VITE_BILLING_WA=
# Nomor WhatsApp resmi Eira (Cloud API) yang ditampilkan saat menautkan nomor di Profil
VITE_EIRA_WA=
# Identitas penjual di invoice langganan (opsional). Alamat: pisahkan baris dengan |
VITE_INVOICE_NAMA=PT Dentiva Teknologi Nusantara
VITE_INVOICE_ALAMAT=
VITE_INVOICE_NPWP=
