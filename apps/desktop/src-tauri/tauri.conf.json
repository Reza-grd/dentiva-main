{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dentiva",
  "version": "../package.json",
  "identifier": "id.co.dentiva.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../clinic/dist",
    "beforeDevCommand": "npm --prefix ../clinic run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../clinic run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dentiva",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' https://ggwratzhpukgsiduqely.supabase.co",
        "script-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https://ggwratzhpukgsiduqely.supabase.co",
        "connect-src": "ipc: http://ipc.localhost 'self' https://ggwratzhpukgsiduqely.supabase.co wss://ggwratzhpukgsiduqely.supabase.co blob: https://gate.whapi.cloud https://*.ingest.sentry.io https://*.ingest.us.sentry.io",
        "frame-src": "'self' blob:",
        "object-src": "'self' blob:",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Dentiva",
    "copyright": "© 2026 Dentiva",
    "category": "Medical",
    "shortDescription": "Sistem manajemen klinik gigi",
    "longDescription": "Dentiva — rekam medis elektronik, jadwal, antrean, dan kasir untuk klinik gigi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
