# Dentiva Console — salin ke .env.local
# Hanya ANON key. Service role key TIDAK PERNAH boleh ada di aplikasi ini.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Opsional: proyek Sentry TERPISAH dari aplikasi klinik
VITE_SENTRY_DSN=

# Label lingkungan yang tampil di pojok kiri bawah (mis. staging / production)
VITE_APP_ENV=development
