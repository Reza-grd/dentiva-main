# Dentiva: hanya jalur API yang dipakai aplikasi yang diteruskan.
# Studio (dashboard) sengaja TIDAK dibuka ke internet — akses lewat terowongan SSH.
{$PROXY_DOMAIN} {
    @supabase_api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /functions/v1/*

    handle @supabase_api {
        reverse_proxy api-gw:8000
    }

    handle {
        respond "Dentiva API" 404
    }

    header {
        -server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
